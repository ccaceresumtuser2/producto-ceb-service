        <mxCell id="leyendaCapas" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#BBBBBB;verticalAlign=top;align=left;spacing=12;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Capas&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table style=&quot;font-size:11px;border-collapse:collapse&quot; cellpadding=&quot;3&quot;&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Anillo&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Contiene&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Depende de&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Modelo de dominio&lt;/td&gt;&lt;td&gt;Entidades y reglas de negocio&lt;/td&gt;&lt;td&gt;Nadie&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Servicios de dominio&lt;/td&gt;&lt;td&gt;Contratos que necesita el dominio&lt;/td&gt;&lt;td&gt;Modelo&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Servicios de aplicación&lt;/td&gt;&lt;td&gt;Casos de uso: coordinan cada acción&lt;/td&gt;&lt;td&gt;Dominio&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Infraestructura&lt;/td&gt;&lt;td&gt;HTTP, JPA, Swagger, Spring&lt;/td&gt;&lt;td&gt;Todas las internas&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b&gt;domain&lt;/b&gt; y &lt;b&gt;application&lt;/b&gt; son Java puro: sin anotaciones de Spring.&lt;br&gt;&lt;b&gt;ProductoController&lt;/b&gt; depende de las interfaces &lt;b&gt;I*Producto&lt;/b&gt;,&lt;br&gt;nunca de las clases concretas.&lt;br&gt;&lt;b&gt;BeanConfig&lt;/b&gt; es el único que conoce las clases concretas: crea cada&lt;br&gt;servicio, le inyecta &lt;b&gt;ProductoRepositoryJpa&lt;/b&gt; como &lt;b&gt;IProductoRepository&lt;/b&gt;&lt;br&gt;y lo registra con el tipo de su interfaz.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="320" width="440" x="1240" y="110" as="geometry" />
        </mxCell>
        <mxCell id="leyendaFlujo" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#BBBBBB;verticalAlign=top;align=left;spacing=12;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Flujo: PATCH /api/productos/1/precio&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;1. &lt;b&gt;ProductoController&lt;/b&gt; &lt;i&gt;(infraestructura)&lt;/i&gt; recibe la petición&lt;br&gt;2. llama a &lt;b&gt;ICambiarPrecioProducto&lt;/b&gt; &lt;i&gt;(aplicación)&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;→ la implementa &lt;b&gt;CambiarPrecioProducto&lt;/b&gt;&lt;br&gt;3. &lt;b&gt;IProductoRepository.buscarPorId&lt;/b&gt; &lt;i&gt;(servicios de dominio)&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;→ lo resuelve &lt;b&gt;ProductoRepositoryJpa&lt;/b&gt; contra PostgreSQL&lt;br&gt;4. &lt;b&gt;producto.cambiarPrecio(...)&lt;/b&gt; &lt;i&gt;(modelo)&lt;/i&gt; aplica la regla&lt;br&gt;5. &lt;b&gt;IProductoRepository.guardar&lt;/b&gt; persiste el cambio&lt;br&gt;6. el controlador responde &lt;b&gt;RespuestaApi&lt;/b&gt; { message, timestamp, data, status }&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="440" x="1240" y="445" as="geometry" />
        </mxCell>
        <mxCell id="leyendaFlechas" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#BBBBBB;verticalAlign=top;align=left;spacing=12;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Flechas&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;──▷ &amp;nbsp;usa / depende de (siempre hacia adentro)&lt;br&gt;- - -▷ &amp;nbsp;implementa una interfaz&lt;br&gt;[ «interface» IXxx | Xxx ] &amp;nbsp;interfaz arriba, implementación abajo&lt;br&gt;◁──▷ &amp;nbsp;comunicación con sistemas externos&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="440" x="1240" y="670" as="geometry" />
        </mxCell>
        <mxCell id="leyendaComparacion" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#BBBBBB;verticalAlign=top;align=left;spacing=12;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Hexagonal → Cebolla&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table style=&quot;font-size:10px;border-collapse:collapse&quot; cellpadding=&quot;2&quot;&gt;&lt;tr&gt;&lt;td&gt;core/model, core/exception&lt;/td&gt;&lt;td&gt;→ domain/model, domain/exception&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;core/ports/out (3 PortOut)&lt;/td&gt;&lt;td&gt;→ domain/services/IProductoRepository&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;core/ports/in (PortIn)&lt;/td&gt;&lt;td&gt;→ application/I*Producto&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;core/usecase&lt;/td&gt;&lt;td&gt;→ application&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;adapters/in/web&lt;/td&gt;&lt;td&gt;→ infrastructure/web&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;adapters/out/persistence&lt;/td&gt;&lt;td&gt;→ infrastructure/persistence&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;config&lt;/td&gt;&lt;td&gt;→ infrastructure/config&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="220" width="440" x="1240" y="805" as="geometry" />
        </mxCell>
